# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/knowledge_base"
# For Railway: Use connection string from Railway dashboard
# Railway format: postgresql://postgres:PASSWORD@CONTAINER.railway.app:PORT/railway

# Optional: Database debugging (set to "true" to enable connection logging)
# DEBUG_DB="false"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# OAuth Providers (configure as needed)
# GOOGLE_CLIENT_ID="" - Required for Google OAuth sign-in and Google Drive import
# GOOGLE_CLIENT_SECRET="" - Required for Google OAuth sign-in
# NEXT_PUBLIC_GOOGLE_API_KEY="" - Optional: API key for Google Picker (improves performance)
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# Optional: Redis for caching (if using Vercel KV)
# KV_URL=""
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""
# KV_REST_API_READ_ONLY_TOKEN=""

# Optional: File storage (if using external storage)
# UPLOADTHING_SECRET=""
# UPLOADTHING_APP_ID=""

# DigitalOcean Spaces Configuration (for image storage)
# Получить ключи: DigitalOcean Dashboard -> API -> Tokens/Keys -> Generate New Key
# DO_SPACES_ENDPOINT="uppstaff.ams3.digitaloceanspaces.com" - Origin endpoint (для загрузки)
# DO_SPACES_CDN_ENDPOINT="uppstaff.ams3.cdn.digitaloceanspaces.com" - CDN endpoint (для публичных URL, быстрее)
# DO_SPACES_KEY="your-spaces-access-key" - Access Key ID
# DO_SPACES_SECRET="your-spaces-secret-key" - Secret Access Key
# DO_SPACES_BUCKET="uppstaff" - Имя bucket (по умолчанию "uppstaff")
# DO_SPACES_REGION="ams3" - Регион (по умолчанию "ams3")
# DO_SPACES_USE_CDN="true" - Использовать CDN для публичных URL (по умолчанию true)

# Playwright Test Credentials (for E2E tests)
# TEST_USER_EMAIL="test-user@example.com" - Email for test user authentication
# TEST_USER_PASSWORD="test-password-123" - Password for test user
# Note: Create a real test user in your database and use those credentials here

# Optional: AI/ML services
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GROK_API_KEY=""

# Email Configuration (for password reset and notifications)
# Works with any SMTP provider: Gmail, Outlook, Yahoo, SendGrid, Mailgun, Amazon SES, etc.
# See SMTP_PROVIDERS_SETUP.md for provider-specific configurations
#
# SMTP_HOST="smtp.gmail.com" - SMTP server hostname (varies by provider)
# SMTP_PORT="587" - SMTP port (587 for TLS, 465 for SSL)
# SMTP_SECURE="false" - Set to "true" for SSL (port 465), "false" for TLS (port 587)
# SMTP_USER="your-email@gmail.com" - SMTP username/email
# SMTP_PASSWORD="your-app-password" - SMTP password or app-specific password
# SMTP_FROM="noreply@example.com" - From email address (defaults to SMTP_USER if not set)
# 
# Common providers:
# - Gmail: smtp.gmail.com:587 (requires App Password)
# - Outlook: smtp-mail.outlook.com:587
# - SendGrid: smtp.sendgrid.net:587 (username: "apikey")
# - Mailgun: smtp.mailgun.org:587
# - Amazon SES: email-smtp.REGION.amazonaws.com:587
# 
# Note: In development without SMTP configured, emails will be logged to console

# Stripe Payment Integration
# Обязательные переменные для работы Stripe
# 
# Получить ключи: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY="sk_test_..." - секретный ключ API (обязательно)
# STRIPE_PUBLISHABLE_KEY="pk_test_..." - публичный ключ для клиента (обязательно)
# 
# Получить webhook secret: https://dashboard.stripe.com/webhooks
# Для локальной разработки: stripe listen --forward-to localhost:3000/api/stripe/webhook
# STRIPE_WEBHOOK_SECRET="whsec_..." - секрет webhook для верификации событий (обязательно)
# 
# Примечание: можно использовать NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY вместо STRIPE_PUBLISHABLE_KEY
# Подробнее: см. STRIPE_VARIABLES.md